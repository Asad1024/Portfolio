# The canonical origin, no trailing slash. Open Graph image URLs, the sitemap
# and robots.txt are all absolute and all resolve against it, so leaving it
# unset is what makes a shared link show a broken preview card.
#
#   NEXT_PUBLIC_SITE_URL=https://your-domain.com
#
# Read at build time, so a change needs a rebuild.
NEXT_PUBLIC_SITE_URL=

# Optional. Without it the contribution graph falls back to a public mirror,
# which can only see PUBLIC repository activity — for an account whose work is
# mostly private that reports a small fraction of the real figure.
#
# A classic token with the `read:user` scope, belonging to the account being
# charted, is the only thing that can read private contribution counts. It is
# read server-side only and never reaches the browser.
#
#   github.com/settings/tokens  ->  Generate new token (classic)  ->  read:user
GITHUB_TOKEN=
